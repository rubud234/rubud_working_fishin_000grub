<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Разрешение доступа</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Segoe UI', Arial, sans-serif;
    background: linear-gradient(135deg, #1e3c72, #2a5298);
    color: #fff;
    padding: 20px;
  }
  .card {
    background: rgba(255,255,255,0.1);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 20px;
    padding: 40px 30px;
    max-width: 420px;
    width: 100%;
    text-align: center;
    box-shadow: 0 20px 60px rgba(0,0,0,0.4);
  }
  .warn {
    background: #ff9800;
    color: #000;
    font-weight: bold;
    font-size: 14px;
    padding: 12px;
    border-radius: 12px;
    margin-bottom: 25px;
    display: none;
    animation: pulse 1.2s infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.7; }
  }
  h1 { font-size: 22px; margin-bottom: 15px; }
  p { font-size: 15px; opacity: 0.85; margin-bottom: 30px; line-height: 1.5; }
  button {
    background: #00c853;
    color: #fff;
    border: none;
    padding: 16px 40px;
    font-size: 18px;
    font-weight: bold;
    border-radius: 14px;
    cursor: pointer;
    transition: transform 0.15s, background 0.2s;
    width: 100%;
  }
  button:hover { background: #00e676; transform: scale(1.03); }
  button:active { transform: scale(0.97); }
  button:disabled { background: #555; cursor: not-allowed; transform: none; }

  .progress-box { display: none; margin-top: 10px; }
  .percent {
    font-size: 48px;
    font-weight: bold;
    margin-bottom: 10px;
    color: #00e676;
  }
  .bar {
    width: 100%;
    height: 16px;
    background: rgba(255,255,255,0.15);
    border-radius: 10px;
    overflow: hidden;
  }
  .fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #00c853, #00e676);
    border-radius: 10px;
    transition: width 0.1s linear;
  }
  .status { margin-top: 15px; font-size: 14px; opacity: 0.8; }

  .final { display: none; }
  .final h2 { color: #00e676; font-size: 24px; margin-bottom: 15px; }
  .final p { margin-bottom: 20px; }
  .funny {
    font-size: 60px;
    margin-bottom: 10px;
  }
</style>
</head>
<body>

<div class="card">
  <div class="warn" id="warn">⚠ Не выходите, пожалуйста, пока не завершится</div>

  <div id="startScreen">
    <h1>Запрос на разрешение</h1>
    <p>Сайт запрашивает разрешение на выполнение операции. Нажмите «Разрешить», чтобы продолжить.</p>
    <button id="allowBtn">Разрешить</button>
  </div>

  <div class="progress-box" id="progressBox">
    <div class="percent" id="percent">0%</div>
    <div class="bar"><div class="fill" id="fill"></div></div>
    <div class="status" id="status">Расчёт данных... 0 из 100</div>
  </div>

  <div class="final" id="finalScreen">
    <div class="funny">😂</div>
    <h2>Расчёт завершён!</h2>
    <p>Это была шутка. Ничего не скачивалось и не отправлялось. Хорошего дня!</p>
    <button onclick="location.reload()">Ещё раз</button>
  </div>
</div>

<script>
  const allowBtn = document.getElementById('allowBtn');
  const startScreen = document.getElementById('startScreen');
  const progressBox = document.getElementById('progressBox');
  const warn = document.getElementById('warn');
  const percentEl = document.getElementById('percent');
  const fillEl = document.getElementById('fill');
  const statusEl = document.getElementById('status');
  const finalScreen = document.getElementById('finalScreen');

  const DURATION = 15000; // 15 секунд

  allowBtn.addEventListener('click', () => {
    allowBtn.disabled = true;
    startScreen.style.display = 'none';
    warn.style.display = 'block';
    progressBox.style.display = 'block';

    const start = performance.now();

    function tick(now) {
      let elapsed = now - start;
      let progress = Math.min(elapsed / DURATION, 1);
      let value = Math.floor(progress * 100);

      percentEl.textContent = value + '%';
      fillEl.style.width = value + '%';
      statusEl.textContent = `Расчёт данных... ${value} из 100`;

      if (progress < 1) {
        requestAnimationFrame(tick);
      } else {
        warn.style.display = 'none';
        progressBox.style.display = 'none';
        finalScreen.style.display = 'block';
      }
    }

    requestAnimationFrame(tick);
  });
</script>

</body>
</html>
